# Copy to .env.local and fill in. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only. Get it from the dashboard: Project Settings > API keys > service_role.
# Never prefix this with NEXT_PUBLIC_ — that would ship it to the browser and
# hand every visitor a key that bypasses every RLS policy in the database.
SUPABASE_SERVICE_ROLE_KEY=

# Phase 1. Twilio Verify, own subaccount.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Phase 6. Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:joeylameri@outlook.com

# Reading fixture screenshots (/scan). Server-side only — it is a spending
# key, so it must never get a NEXT_PUBLIC_ prefix. Without it the scan page
# says the feature is unavailable rather than failing halfway through an
# upload.
ANTHROPIC_API_KEY=

# Shared secret the database uses to wake the push sender (push-now function).
# Without it the wake-up is skipped and the five-minute sweep still delivers,
# just later.
PUSH_WAKE_SECRET=
