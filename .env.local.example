# Copy to .env.local and fill in. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only. Get it from the dashboard: Project Settings > API keys > service_role.
# Never prefix this with NEXT_PUBLIC_ — that would ship it to the browser and
# hand every visitor a key that bypasses every RLS policy in the database.
SUPABASE_SERVICE_ROLE_KEY=

# Phase 1. Twilio Verify, own subaccount.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Phase 6. Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:joeylameri@outlook.com

# Reading fixture screenshots (/scan). Server-side only — it is a spending
# key, so it must never get a NEXT_PUBLIC_ prefix. Without it the scan page
# says the feature is unavailable rather than failing halfway through an
# upload.
ANTHROPIC_API_KEY=

# Shared secret the database uses to wake the push sender (push-now function).
# Without it the wake-up is skipped and the five-minute sweep still delivers,
# just later.
PUSH_WAKE_SECRET=

# Native push. iOS talks to APNs directly, so no Firebase is needed for an
# iPhone-only pilot. Missing credentials mean those rows are SKIPPED, never
# failed — a missing key must not retire a parent's subscription.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=app.squadroom.mobile
APNS_PRIVATE_KEY=
# APNS_ENVIRONMENT=sandbox   # only for a debug build straight from Xcode

# Android push must go through Firebase; Google owns the transport.
FCM_SERVICE_ACCOUNT=

# Phase 8. Stripe Connect Express. Test keys (sk_test_…) exercise the entire
# flow with no real money — use them until a real academy is onboarding.
STRIPE_SECRET_KEY=
# From the webhook endpoint you create in the Stripe dashboard. Without it the
# webhook refuses every request, which is correct: an unverified body must
# never be able to mark a season's fees paid.
STRIPE_WEBHOOK_SECRET=
# Where Stripe sends people back to. Netlify also serves the app from a
# deploy-unique hostname, and a return URL built from the request origin can
# land on a host with no session cookie.
NEXT_PUBLIC_SITE_URL=https://squadroom-dev.netlify.app

# Reserved for ONE case: a match cancelled or moved inside 24 hours. A general
# SMS fallback was costed at ~$4k/week at 300 academies and cut. Without these
# the escalation is skipped and push still goes out.
TWILIO_FROM_NUMBER=
