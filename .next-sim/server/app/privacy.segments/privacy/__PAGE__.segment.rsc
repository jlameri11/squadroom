c:[["children",{"s":"__PAGE__","h":160,"d":{"r":["$","$2","c",{"children":[["$","main",null,{"className":"mx-auto w-full max-w-lg px-5 pb-16 pt-8","style":{"background":"var(--paper)"},"children":[["$","p",null,{"className":"eyebrow","children":"Squadroom"}],["$","h1",null,{"className":"display mt-1 text-[1.875rem] leading-tight","children":"How we look after your info"}],["$","p",null,{"className":"mt-2 text-sm text-ink-2","children":"Written for the kids who open a Squadroom page. The grown-up version is underneath."}],["$","section",null,{"className":"card mt-6 p-4 text-[0.9375rem] leading-relaxed","children":[["$","h2",null,{"className":"font-semibold","children":"If you're a player"}],["$","ul",null,{"className":"mt-2 list-disc space-y-2 pl-5","children":[["$","li",null,{"children":[["$","b",null,{"children":"You don't need an account."}]," You open the page your coach or parent sent you, and you can see the draw, the scores and the ladder. That's it."]}],["$","li",null,{"children":[["$","b",null,{"children":"We don't watch you."}]," The page has no ads and no trackers. We don't know who opened it."]}],["$","li",null,{"children":[["$","b",null,{"children":"Your name on the page is your club's choice, and your family's."}]," Some clubs show full names, some show just “Leo W.”, some show no names. Your parent can switch your name off whenever they like, and that always wins."]}],["$","li",null,{"children":[["$","b",null,{"children":"Your photo is never on the internet."}]," If your club keeps one, it's only on your player card, which only your family, your coaches and the referee on match day can open."]}],["$","li",null,{"children":[["$","b",null,{"children":"Your messages are with your team."}]," A coach can't message you on your own — a parent is always in the chat too."]}],["$","li",null,{"children":[["$","b",null,{"children":"If something feels wrong, tell a grown-up."}]," Your parent can report it from the app, and only the club's safeguarding people see it."]}]]}]]}],["$","section",null,{"className":"card mt-4 p-4 text-sm leading-relaxed text-ink-2","children":[["$","h2",null,{"className":"font-semibold text-ink","children":"For parents and carers"}],["$","dl",null,{"className":"mt-2 space-y-3","children":[["$","div",null,{"children":[["$","dt",null,{"className":"font-medium text-ink","children":"What we hold about a child"}],["$","dd",null,{"children":"Name, date of birth, squad and shirt number; the kit sizes, medical notes and emergency contacts you give the club; the agreements you sign; a photo if you add one. Nothing is collected from the child directly — children have no accounts."}]]}],["$","div",null,{"children":[["$","dt",null,{"className":"font-medium text-ink","children":"Who can see it"}],["$","dd",null,{"children":"The club's owners, admins and coaches. Medical notes: club staff only — never another club, never a league. The player card (photo, squad, number, date of birth): the family, the club's coaches, a league's officials while the child is on a season squad, and the opposing manager on match day only. Public competition pages show clubs and scores; names only by the club's rule, and never if you have switched them off."}]]}],["$","div",null,{"children":[["$","dt",null,{"className":"font-medium text-ink","children":"What we never do"}],["$","dd",null,{"children":"No advertising, no analytics on public pages, no sale or sharing of data, no address-book uploads, no fees charged to families by Squadroom. Children are never alone with an adult in a private chat."}]]}],["$","div",null,{"children":[["$","dt",null,{"className":"font-medium text-ink","children":"Your controls"}],["$","dd",null,{"children":"Settings → My family: each child's details, medical notes, agreements (agree or withdraw, versioned), kit sizes, the public-name switch, and who can see what. Settings → Your data: download everything we hold, or erase your account — the function tells you what is kept and why (safeguarding reports, the club's payment records, WWCC records, and the child's roster row, which belongs to the club)."}]]}],"$Ld","$Le"]}]]}]]}],null,"$Lf"]}],"p":"$@10","v":null,"s":"$b"}}]]
